<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>orchestra</title>
  </head>
  <body>
    <div>
      <button id="run">Run</button>
    </div>
    <div class="orchestra">
      instrument_ui(note1, a)
      instrument_ui(note2, s)
      instrument_ui(note3, d)
      instrument_ui(note4, f)
      instrument_ui(note5, w)
    </div>

    <div class="sensors">
      <label for="sensors">sensors</label>
      <div class="gyroscope">
        <label for="gyroscope">gyroscope</label>
        <label for="x">x</label>
        <input name="gyro_sensor_x", id="gyro_sensor_x" />
        <label for="y">y</label>
        <input name="gyro_sensor_y", id="gyro_sensor_y" />
        <label for="z">z</label>
        <input name="gyro_sensor_z", id="gyro_sensor_z" />
      </div>
    </div>

    <script type="module", src="scripts/fm.js"></script>
    <script type="module", src="scripts/keys.js"></script>
    <script type="module", src="scripts/gui.js"></script>
    <script type="module", src="scripts/orchestra.js"></script>
  </body>
</html>
