define(`instrument_slider',
<label for="$1_$2">$1 $2</label>
          <input
              name="$1_$2"
              id="$1_$2"
              type="range"
              min="0"
              max="100"
              step="0.01"
              value="50" />
)dnl

define(`instrument_ui',
        <div
          id="$1"
          style="border: 2px solid black;" >
          <div>
          <label for="$1">$1 (press [$2] to play)</label>
          </div>
          instrument_slider($1, hz)
          instrument_slider($1, amp)
          instrument_slider($1, mod)
          instrument_slider($1, depth)
        </div>)dnl
