define(`note_spec',
        <div
          id="$1"
          style="border: 2px solid black;" >
          <div>
          <label for="$1">$1</label>
          </div>
          <label for="$1_hz">$1 hz</label>
          <input
              name="$1_hz"
              id="$1_hz"
              type="range"
              min="20"
              max="10000"
              step="0.01"
              value="1000" />
          <label for="$1_amp">$1 amp</label>
          <input
              name="$1_amp"
              id="$1_amp"
              type="range"
              min="0.0"
              max="1.0"
              step="0.01"
              value="0.5" />
        </div>)dnl
dnl
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>instrument</title>
    <!-- <link rel="stylesheet" href="style.css"> -->
    <!-- <script src="script.js"></script> -->
  </head>
  <body>
    <div class="instrument">
      <div>
      <label for="instrument">instrument</label>
      </div>

      <div>
      <button class="mute" data-muted="false">Mute</button>
      </div>
      <div class="notes">
        note_spec(note1)
        note_spec(note2)
        note_spec(note3)
        note_spec(note4)
        note_spec(note5)
      </div>
    </div>

    <script type="module", src="scripts/pure.js"></script>
    <script type="module", src="scripts/app.js"></script>
    <script type="module", src="scripts/fm.js"></script>
    <script type="module", src="scripts/top_level.js"></script>
  </body>
</html>
