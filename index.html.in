define(`note_spec',
        <div style="border: 2px solid black;">
          <div>
          <label for="$1">note 1</label>
          </div>
          <label for="note1_hz">note1 hz</label>
          <input
              name="note1_hz"
              id="note1_hz"
              type="range"
              min="20"
              max="10000"
              value="1000" />
        </div>)dnl
dnl
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>instrument</title>
    <!-- <link rel="stylesheet" href="style.css"> -->
    <!-- <script src="script.js"></script> -->
  </head>
  <body>
    <div class="instrument">
      <div>
      <label for="instrument">instrument</label>
      </div>

      <div>
      <button class="mute" data-muted="false">Mute</button>
      <div class="app">
        note_spec(note1)
      </div>
    </div>

    <script type="module", src="scripts/pure.js"></script>
    <script type="module", src="scripts/app.js"></script>
    <script type="module", src="scripts/fm.js"></script>
    <script type="module", src="scripts/top_level.js"></script>
  </body>
</html>
